local entries
local registered=false

local function build_catalogue()
   local result={}
   local ini=system_ini()
   ini:section_for_each(function(section)
      local parent=ini:line_exist(section,"parent_section") and ini:r_string(section,"parent_section") or section
      if not ROOTS[parent] or section=="pri_a17_gauss_rifle" then return false end
      if ini:line_exist(section,"quest_item") and ini:r_bool(section,"quest_item") then return false end
      if not ini:line_exist(section,"class") or not ini:line_exist(section,"slot") then return false end
      local class=ini:r_string(section,"class")
      if class:sub(1,3)~="WP_" then return false end
      local slot=ini:r_s32(section,"slot")
      if slot==1 or slot==2 then result[section]={kind=slot==1 and "pistol" or "rifle"} end
      return false
   end)
   return result
end

function on_game_start(data)
   if registered then return end
   if not IsModuleLoaded("ixr_registry") then return end
   entries=entries or build_catalogue()
   local maps=GetRegistryValue("sgm_bodyguards",SGM_EXTENSIONS_KEY,{})
   maps.stcop=entries
   SetRegistryValue("sgm_bodyguards",SGM_EXTENSIONS_KEY,maps)
   local service=GetRegistryValue("sgm_bodyguards",SGM_SERVICE_KEY)
   if service and service.version==1 then service.register_equipment("stcop",entries) end
   registered=true
end
