local phrase_specs = {}

local function select_order(key)
    local spec = order_specs[key]

    sgm_dialogs.custom_order(spec.cost)
    sgm_dialogs.choose_item(spec.item, spec.rank)
end

local function build_trader_dialog(dlg, trader_key)
    local trader = trader_dialogs[trader_key]
    local back = trader.back or "831209900"

    if trader.entry_parents then
        local category_id = "stcop_order_" .. trader_key .. "_category"
        dlg:AddPhrase("zat_stalker_trader_dialog_20", category_id, trader.entry_parents[1], -10000)
        for index = 2, #trader.entry_parents do
            dlg:AddPhrase("zat_stalker_trader_dialog_20", category_id, trader.entry_parents[index], -10000)
        end
        dlg:AddPhrase(trader.text_prefix .. "_dialog_17", trader.root, category_id, -10000)
        dlg:AddPhrase("", "12888", trader.root, -12000)
    end

    for index, item in ipairs(trader.items) do
        local phrase_id = string.format("stcop_order_%s_%d", trader_key, index)
        local details_id = phrase_id .. "_details"
        local accept_id = phrase_id .. "_accept"
        local less_money_id = phrase_id .. "_less_money"
        local cancel_id = phrase_id .. "_cancel"
        local caption_id = sgm_functions.ReadCaption(item)
        local caption = caption_id and game.translate_string(caption_id) or item
        local cost = math.max(1, math.floor(sgm_functions.ReadCost(item) * 0.25 + 0.5))
        local priority = -10000 - index

        phrase_specs[phrase_id] = { item = item, cost = cost, rank = 0 }

        local choice = dlg:AddPhrase(caption, phrase_id, trader.root, priority)
        choice:GetPhraseScript():AddAction("sgm_stcop_trader_orders.select_dialog_item")

        local details = dlg:AddPhrase(trader.text_prefix .. "_dialog_16", details_id, phrase_id, priority)
        details:GetPhraseScript():AddAction("sgm_dialogs.show_order_costs")
        local back_phrase = dlg:AddPhrase("zat_trader_back_phrase", back, details_id, priority)
        if back_phrase then
            dlg:AddPhrase(trader.text_prefix .. "_dialog_17", trader.root, back, priority)
        end

        local accept = dlg:AddPhrase(trader.text_prefix .. "_dialog_15", accept_id, details_id, priority)
        accept:GetPhraseScript():AddPrecondition("sgm_dialogs.order_has_money")
        accept:GetPhraseScript():AddAction("sgm_dialogs.order_agree_give_money")
        accept:GetPhraseScript():AddGiveInfo(trader.order_info)
        dlg:AddPhrase("", "12005", accept_id, priority)

        local less_money = dlg:AddPhrase(trader.text_prefix .. "_dialog_13", less_money_id, details_id, priority)
        less_money:GetPhraseScript():AddPrecondition("sgm_dialogs.order_agree_less_money")
        less_money:GetPhraseScript():AddAction("dialogs.break_dialog")

        local cancel = dlg:AddPhrase(trader.text_prefix .. "_dialog_14", cancel_id, details_id, priority)
        cancel:GetPhraseScript():AddPrecondition("sgm_dialogs.order_has_money")
        cancel:GetPhraseScript():AddAction("dialogs.break_dialog")
    end
end

function select_dialog_item(first_speaker, second_speaker, dialog_id, phrase_id)
    local spec = phrase_specs[phrase_id]
    if not spec then
        printf("! [SGM STCOP] Unknown trader order phrase: %s", tostring(phrase_id))
        return
    end

    sgm_dialogs.custom_order(spec.cost)
    sgm_dialogs.choose_item(spec.item, spec.rank)
end

function init_esc_stalker_dialog(dlg) build_trader_dialog(dlg, "esc_stalker") end
function init_jup_ecolog_dialog(dlg) build_trader_dialog(dlg, "jup_ecolog") end
function init_jup_freedom_dialog(dlg) build_trader_dialog(dlg, "jup_freedom") end
function init_jup_killer_dialog(dlg) build_trader_dialog(dlg, "jup_killer") end
function init_jup_rasvet_dialog(dlg) build_trader_dialog(dlg, "jup_rasvet") end
function init_mar_stalker_dialog(dlg) build_trader_dialog(dlg, "mar_stalker") end
function init_mil_night_stalker_dialog(dlg) build_trader_dialog(dlg, "mil_night_stalker") end
function init_pri_army_dialog(dlg) build_trader_dialog(dlg, "pri_army") end
function init_pri_monolith_dialog(dlg) build_trader_dialog(dlg, "pri_monolith") end
function init_val_night_stalker_dialog(dlg) build_trader_dialog(dlg, "val_night_stalker") end
function init_zat_bandit_dialog(dlg) build_trader_dialog(dlg, "zat_bandit") end
function init_zat_stalker_dialog(dlg) build_trader_dialog(dlg, "zat_stalker") end

function select_kriss_vector(first_speaker, second_speaker)
    select_order("kriss_vector")
end

